NEXT_PUBLIC_BASE_URL=http://localhost:3000

# next dev reads .env.development.local (local `supabase start`).
# next build reads .env.production.local. Neither file is committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Auth reads these for the local Google provider. Leave them empty until the provider is configured.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Public client id for the Google One Tap widget. Same value as the client id above. The secret stays server-side.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Sentry and the Vercel project use the same names. SENTRY_AUTH_TOKEN stays only in the host env.
SENTRY_ORG=ethberry
SENTRY_PROJECT=atlas-archive
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
